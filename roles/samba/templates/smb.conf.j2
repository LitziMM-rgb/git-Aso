[global]
   workgroup = WORKGROUP
   server string = Servidor Samba
   security = user
   map to guest = never

[{{ samba_share_name }}]
   comment = Recurso compartido
   path = {{ samba_share_path }}
   valid users = {{ samba_user }}
   browseable = yes
   read only = no
   create mask = {{ samba_create_mask }}
   directory mask = {{ samba_directory_mask }}
